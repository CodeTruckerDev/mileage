# mileage.kv

<MileageLayout>:

    orientation: 'vertical'
    padding: 20
    spacing: 10

    BoxLayout:
        orientation: 'vertical'
        size_hint_y: None
        height: '60dp'
        spacing: 10

        # Przycisk wybierający miesiąc
        Button:
            text: "Wybrany miesiąc"
            font_size: '20sp'
            background_color: (1, 1, 0, 1)  # kolor żółty
            on_press: root.show_month_selector()

        # Wyświetla aktualnie wybrany miesiąc (np. "Maj 2025")
        Label:
            text: root.selected_month_display
            font_size: '16sp'
            color: (1, 1, 0, 1)  # kolor zolty

    # Informacja okreslająca początek trasy
    Label:
        text: "Początek trasy"
        font_size: '16sp'
        size_hint_y: None
        height: self.texture_size[1] + 10

    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: '30dp'
        spacing: 10

        # Pole do wpisania przebiegu początkowego
        TextInput:
            id: start_input
            text: root.start
            input_filter: 'int'
            input_type: 'number'
            hint_text: "Przebieg auta przy rozpoczęciu trasy"
            hint_text_color: 1, 1, 1, 1  # kolor biały
            foreground_color: 1, 1, 1, 1  # tekst biały - czytelny na zielonym i niebieskim
            background_color: (0.2, 0.6, 0.3, 1) if self.focus else (0, 0, 1, 1)  # przygaszony zielony aktywny, niebieski nieaktywny
            disabled: root.start_locked
            on_text: root.update_start(self.text)

        # Przycisk blokujący/odblokowujący pole przebiegu początkowego
        Button:
            id: start_button
            text: "Zmień" if root.start_locked else "Zapisz"
            color: (0.2, 0.8, 0.9, 1) if root.start_locked else (1, 1, 1, 1)  # cyjan po blokadzie, biały domyślnie
            width: '50dp'
            on_press: root.unlock_start() if root.start_locked else root.lock_start()

    # Informacja okreslająca koniec trasy
    Label:
        text: "Koniec trasy"
        font_size: '16sp'
        size_hint_y: None
        height: self.texture_size[1] + 10

    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: '30dp'
        spacing: 10

        # Pole do wpisania przebiegu końcowego
        TextInput:
            id: end_input
            text: root.end
            input_filter: 'int'
            input_type: 'number'
            hint_text: "Przebieg auta po zakończeniu trasy"
            hint_text_color: 1, 1, 1, 1  # kolor bialy
            foreground_color: 1, 1, 1, 1  # tekst bialy - czytelny na czerwonym i niebieskim
            background_color: (0.8, 0.2, 0.2, 1) if self.focus else (0, 0, 1, 1)  # przygaszony czerwony aktywny, niebieski nieaktywny
            disabled: root.end_locked
            on_text: root.update_end(self.text)

        # Przycisk blokujący/odblokowujący pole przebiegu końcowego
        Button:
            id: end_button
            text: "Zmień" if root.end_locked else "Zapisz"
            color: (0.2, 0.8, 0.9, 1) if root.end_locked else (1, 1, 1, 1)  # cyjan po blokadzie, bialy domyślnie
            width: '50dp'
            on_press: root.unlock_end() if root.end_locked else root.lock_end()

    # Pole ostrzezenia, gdy wartość końcowa jest mniejsza niż początkowa
    Label:
        bold: True
        text: root.warning_text
        color: (1, 0, 0, 1)  # ostrzeżenie w kolorze czerwonym
        font_size: '14sp'
        size_hint_y: None
        height: '30dp'

    # Informacja okreslająca ilość delegacji
    Label:
        text: "Ilość delegacji"
        font_size: '16sp'
        size_hint_y: None
        height: self.texture_size[1] + 10

    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: '30dp'
        spacing: 10

        # Pole do wpisania ilości delegacji
        TextInput:
            id: deleg_input
            text: "" if root.deleg == 0 else str(root.deleg)
            input_filter: 'int'
            input_type: 'number'
            hint_text: "Ilość delegacji"
            hint_text_color: 1, 1, 1, 1  # kolor bialy
            foreground_color: 1, 1, 1, 1  # tekst bialy - czytelny na pomarańczowym i niebieskim
            background_color: (0.85, 0.45, 0.1, 1) if self.focus else (0, 0, 1, 1)  # przygaszony pomarańczowy aktywny, niebieski nieaktywny
            disabled: root.deleg_locked
            on_text: root.update_deleg(self.text)

        # Przycisk blokujący/odblokowujący pole ilości delegacji
        Button:
            id: deleg_button
            text: "Zmień" if root.deleg_locked else "Zapisz"
            color: (0.2, 0.8, 0.9, 1) if root.deleg_locked else (1, 1, 1, 1)  # cyjan po blokadzie, bialy domyślnie
            width: '50dp'
            on_press: root.unlock_deleg() if root.deleg_locked else root.lock_deleg()

    BoxLayout:
        orientation: 'vertical'
        padding: '12dp'
        spacing: '8dp'

        # Pole opisujące przebieg wprowadzanej trasy
        Label:
            text: "Obecna trasa: " + str(root.total_daily) + " km  -  Delegacji: " + str(root.deleg)
            size_hint_y: None
            font_size: '18sp'

        # Pole opisujące przebieg sumaryczny dla całego miesiąca
        Label:
            text: "Razem: " + str(root.total) + " km  -  Delegacji: " + str(root.d_counter)
            size_hint_y: None
            font_size: '18sp'

        # Pole pamietające ostatni zapisany wpis trasy
        Label:
            text: root.last_entry_text
            size_hint_y: None
            font_size: '16sp'
            color: (0.6, 1, 0.6, 1)  # delikatna zielen

        # Przycisk zapisujący dane i zamykający aplikację po dwóch sekundach
        Button:
            id: confirm_button
            size_hint_y: None
            text: "Zapisz i wyjdź"
            height: '56dp'
            on_press: root.save()

        # Elastyczny margines unoszący przycisk wyżej
        Widget:
            size_hint_y: None
            height: '60dp'

